# J-Quants API V2 のダッシュボードで発行したAPIキーを設定してください。
JQUANTS_API_KEY=

# 日次Jobでは直近の日数を再取得し、Delta MERGEで更新します。
MARKET_DATA_LOOKBACK_DAYS=7

# 特定期間を取得する場合だけ、開始日と終了日を両方指定します。
# MARKET_DATA_START_DATE=2026-01-01
# MARKET_DATA_END_DATE=2026-06-24

# 入出力設定
MARKET_DATA_UNIVERSE_FILE=
MARKET_DATA_OUTPUT_TABLE=main.market_data.daily_candles
MARKET_DATA_OUTPUT_CSV=data/nikkei225_daily_candles.csv
MARKET_DATA_WRITE_MODE=merge

# 連続リクエスト間の待機秒数
MARKET_DATA_REQUEST_INTERVAL_SECONDS=0.2
